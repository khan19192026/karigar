# Copy to .env.local and fill in.
# Leave both blank to run the app on the built-in demo backend (localStorage,
# seeded with D.I. Khan technicians and jobs). No Supabase project needed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sign-in mode:
#   otp   — Supabase phone OTP. Requires an SMS provider (Twilio/Vonage/MessageBird)
#           configured under Authentication > Providers > Phone in the Supabase dashboard.
#   local — no OTP round-trip; the phone number is trusted as-is. Fine for a pilot
#           demo, NOT for production. This is the default when Supabase is unset.
VITE_AUTH_MODE=local

# Web Push public (VAPID) key, for chat notifications while the app is closed.
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key goes here; the private key goes to the Edge Function:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
#   supabase functions deploy send-push
# Then add a Database Webhook on `messages` INSERT → Edge Function `send-push`.
# Leave blank and notifications still work while a tab is open — just not in
# the background.
VITE_VAPID_PUBLIC_KEY=
